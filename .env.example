# AtmosBridge Environment Configuration Template
# Copy this file to .env and provide your credentials

# Gemini API Key (Server-Side Only - Never exposed to frontend)
# Get a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# Google Maps JavaScript API Key (Client-Side - HTTP Referrer Restricted)
# Get a key from Google Cloud Console: https://console.cloud.google.com/google/maps-apis
VITE_GOOGLE_MAPS_API_KEY=

# Backend Host & Port
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Optional External API Keys
OPENAQ_API_KEY=

# Optional Firebase Configuration (for cloud deployment)
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
