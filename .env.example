# AtmosBridge Environment Configuration Template
# Copy this file to .env and provide your credentials

# Gemini API Key (Server-Side Only - Never exposed to frontend)
# Get a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# Backend Host, Port & Environment
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Optional External API Keys (Server-Side)
OPENAQ_API_KEY=

# Optional Allowed CORS Origins (Comma-separated for custom domains)
ALLOWED_ORIGINS=https://atmosbridgeai.vercel.app,http://localhost:5173
